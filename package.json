{
  "name": "vite-ssr-i18n-basic",
  "version": "3.2.0",
  "type": "module",
  "description": "A modern, fast, and SEO-friendly multi-locale static site generator powered by Vite and Eta",
  "main": "./plugins/multi-locale-plugin.js",
  "exports": {
    ".": "./plugins/multi-locale-plugin.js",
    "./generators/*": "./plugins/generators/*.js",
    "./utils/*": "./plugins/utils/*.js",
    "./templates/*": "./plugins/templates/*"
  },
  "files": [
    "plugins",
    "CHANGELOG.md"
  ],
  "keywords": [
    "vite",
    "eta",
    "i18n",
    "internationalization",
    "multi-locale",
    "static-site-generator",
    "ssg",
    "templates",
    "html",
    "build-tool"
  ],
  "author": "Pierre Guilbert <guilbep@example.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/guilbep/vite-ssr-i18n-basic.git"
  },
  "bugs": {
    "url": "https://github.com/guilbep/vite-ssr-i18n-basic/issues"
  },
  "homepage": "https://github.com/guilbep/vite-ssr-i18n-basic#readme",
  "scripts": {
    "test": "npm run build && node -e \"console.log('✅ Build test passed!')\"",
    "start": "vite",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "vite preview --outDir dist",
    "format": "prettier -w .",
    "lint:commit": "commitlint --edit",
    "lighthouse": "npm run build && lhci autorun",
    "lighthouse:collect": "npm run build && lhci collect",
    "lighthouse:upload": "lhci upload",
    "lighthouse:quick": "./lighthouse-test.sh",
    "perf": "npm run lighthouse"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "eta": "^4.6.0",
    "glob": "^11.0.3",
    "html-minifier-terser": "^7.2.0",
    "js-yaml": "^5.4.2",
    "marked": "^18.0.14"
  },
  "optionalDependencies": {
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "concurrently": "^9.2.0",
    "lighthouse": "^12.8.1",
    "vite": "^8.0.14",
    "wait-on": "^8.0.4"
  }
}
